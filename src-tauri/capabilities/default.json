{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://wa.me/*"
        },
        {
          "url": "sms:*"
        },
        {
          "url": "viber:*"
        }
      ]
    },
    "fs:default",
    "dialog:default",
    "shell:default"
  ]
}
